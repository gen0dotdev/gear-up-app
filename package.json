{
  "name": "gear-up-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "dev": "astro dev --port 4400",
    "build": "astro build",
    "preview": "astro preview --port 4401",
    "typecheck": "wrangler types --strict-vars=false && astro check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "auth:migration": "node scripts/auth-migration.ts",
    "staff:local": "node scripts/create-staff.ts",
    "setup:local": "npm run db:migrate:local && npm run db:seed:local && npm run staff:local",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/0001_sample.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "4.3",
    "@tanstack/react-query": "^5.107.1",
    "astro": "7.4",
    "better-auth": "1.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "shadcn": "^4.23.0",
    "typescript": "~6.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "license": "MIT"
}
